# Copy this to /etc/assesshub/backend.env on the EC2 instance.
# Generate JWT_SECRET with:
# openssl rand -base64 32

PORT=8080
DB_URL=jdbc:mysql://localhost:3306/assessment_platform?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=assesshub
DB_PASSWORD=change-this-database-password

JWT_SECRET=MzAxNzMzZDg4OGMzMzk4ZjJlNjYwMDgwNzkzNTEyNDhiMTg5YzUzNmIzY2FkZmRjNjRmNTdjZjNkNWE0YWJjYw==
JWT_EXPIRATION_MS=86400000
OTP_EXPIRATION_MINUTES=5

# If you use Gmail, create an app password and put it here.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Use your EC2 public IP first. Replace it with your domain when DNS is ready.
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# Optional AI question generation.
GEMINI_API_KEY=
GEMINI_MODEL=auto
